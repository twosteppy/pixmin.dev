App(
    appid="pixmin_hub",
    name="Pixmin",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pixmin_hub_app",
    cdefines=["APP_PIXMIN_HUB"],
    requires=["gui", "storage", "notification"],
    stack_size=2 * 1024,
    fap_icon="pixmin_10px.png",
    fap_category="Tools",
    fap_description="pixmin tool hub",
    fap_author="pixmin",
    fap_version="1.0",
    fap_weburl="https://pixmin.dev",
)
